# lifecycle/config.yaml — generated by kaos-control init
# Customise roles, stages, agents, and required_plans to suit your project.

git:
  default_branch: main
  branch_template: requirement/{slug}

roles:
  - product-owner
  - analyst
  - backend-developer
  - frontend-developer
  - test-developer
  - qa
  - reviewer
  - approver
  - devops
  - tech-writer

stages:
  - name: ideas
    dir: ideas
  - name: requirements
    dir: requirements
  - name: backend-plans
    dir: backend-plans
  - name: frontend-plans
    dir: frontend-plans
  - name: test-plans
    dir: test-plans
  - name: tests
    dir: tests
  - name: prototypes
    dir: prototypes
  - name: releases
    dir: releases
  - name: defects
    dir: defects
  - name: docs
    dir: docs

required_plans:
  requirement:
    - plan-backend
    - plan-frontend
    - plan-test

# Answer format for the "## Open Questions" resolution flow. Currently the
# only supported value is "blockquote" (the default).
open_questions:
  answer_format: blockquote

# The initial user. `kaos-control init -owner-email …` populates this
# with the supplied email; otherwise edit the placeholder below before
# starting the server — every project needs at least one user.
users:
  - email: {{if .OwnerEmail}}{{.OwnerEmail}}{{else}}TODO@example.com{{end}}
    roles:
      - product-owner
      - analyst
      - reviewer
      - approver
      - devops

dashboard:
  tracked_types:
    - requirement
    - idea
    - defect

kanban:
  columns:
    - name: Backlog
      statuses:
        - raw
        - draft
    - name: Approved-Ready
      statuses:
        - approved
    - name: In-Progress
      statuses:
        - in-progress
        - clarifying
        - planning
        - in-development
        - in-qa
    - name: Blocked
      statuses:
        - blocked
    - name: Done
      statuses:
        - done
        - abandoned
        - rejected
  uncategorised: true
  card_fields:
    - title
    - type
    - priority
    - labels
    - age

# Architecture Wizard questions. Shipped standard set; edit to suit. Each
# question maps its answers to decision-signal labels on the architecture
# catalog (kind: hard = filters architectures; soft = scores; language = ranks
# stacks). See lifecycle/ideas/onboarding-architecture-selection.md.
architecture_wizard:
  default_architecture: modular-monolith
  questions:
    - id: offline
      prompt: "Does this need to work fully offline, with no network connection required?"
      kind: hard
      options:
        - value: yes
          label: Yes
          labels:
            - offline-capable
          hard: true
        - value: no
          label: No
    - id: collaborative
      prompt: "Will multiple people view or edit shared data at the same time?"
      kind: soft
      options:
        - value: yes
          label: Yes
          labels:
            - collaborative
        - value: no
          label: No
    - id: realtime
      prompt: "Does it need realtime updates or streaming data?"
      kind: soft
      options:
        - value: yes
          label: Yes
          labels:
            - realtime
        - value: no
          label: No
    - id: scale
      prompt: "Do you expect high scale (many users or requests) from the start?"
      kind: soft
      options:
        - value: yes
          label: Yes
          labels:
            - high-scale
        - value: no
          label: No
    - id: mobile
      prompt: "Is this primarily a phone or tablet app?"
      kind: hard
      options:
        - value: yes
          label: Yes
          labels:
            - mobile
          hard: true
        - value: no
          label: No
    - id: ai-ml
      prompt: "Is AI/ML central to what the product does?"
      kind: soft
      options:
        - value: yes
          label: Yes
          labels:
            - ai-ml
        - value: no
          label: No
    - id: ops-tolerance
      prompt: "How much operational complexity can your team take on?"
      kind: soft
      options:
        - value: low
          label: "Low — keep it simple"
          labels:
            - low-complexity
        - value: medium
          label: Medium
          labels:
            - medium-complexity
        - value: high
          label: "High — we have a platform team"
          labels:
            - high-complexity
    - id: cost
      prompt: "Is minimising cost at launch a priority?"
      kind: soft
      options:
        - value: yes
          label: Yes
          labels:
            - low-cost-start
        - value: no
          label: No
    - id: language
      prompt: "What's your team's strongest language?"
      kind: language
      options:
        - value: go
          label: Go
          labels:
            - go
        - value: ts
          label: TypeScript
          labels:
            - typescript
        - value: python
          label: Python
          labels:
            - python
        - value: java
          label: Java
          labels:
            - java
        - value: php
          label: PHP
          labels:
            - php

agents:
  - name: requirements-analyst
    role:
      - analyst
    driver: claude-code-cli
    model: opus
    active_status: clarifying
    timeout_minutes: 0
    allowed_write_paths:
      - lifecycle/requirements
      - lifecycle/ideas
      - lifecycle/architecture/decisions
    git_identity:
      name: Requirements Analyst Agent
      email: requirements-analyst@kaos-control.local
    prompt_templates:
      analyst: |
        You are an analyst for the {{.ProjectName}} project.
        Read the idea artifact at {target_path} and produce a detailed requirement
        artifact in lifecycle/requirements/.

        Required frontmatter:
          title: <concise title>
          type: requirement
          status: draft
          lineage: <same slug as parent idea>
          parent: <path to parent idea>

        Body sections (## headings): Problem, Goals / Non-goals,
        Detailed Requirements, Acceptance Criteria, Open Questions.

  - name: planning-analyst
    role:
      - analyst
    driver: claude-code-cli
    model: opus
    active_status: planning
    timeout_minutes: 0
    allowed_write_paths:
      - lifecycle/backend-plans
      - lifecycle/frontend-plans
      - lifecycle/test-plans
      - lifecycle/requirements
      - lifecycle/architecture/decisions
    git_identity:
      name: Planning Analyst Agent
      email: planning-analyst@kaos-control.local
    prompt_templates:
      analyst: |
        You are an analyst for the {{.ProjectName}} project.
        Read the requirement artifact at {target_path} and produce THREE plan
        artifacts sharing the requirement's lineage:
          1. lifecycle/backend-plans/<slug>-<n>-be.md    (type: plan-backend)
          2. lifecycle/frontend-plans/<slug>-<n>-fe.md   (type: plan-frontend)
          3. lifecycle/test-plans/<slug>-<n>-test.md     (type: plan-test)

        Structure each plan as ordered milestones with description, files to
        change, and explicit acceptance criteria.

  - name: backend-developer
    role:
      - backend-developer
    driver: claude-code-cli
    model: sonnet
    active_status: in-development
    done_on_success: true
    timeout_minutes: 0
    # allowed_write_paths is stack-specific — these defaults match a Go
    # project. Customise to your stack (e.g. `src`, `api`, `server`, …).
    allowed_write_paths:
      - internal
      - cmd
      - lifecycle/backend-plans
      - lifecycle/architecture/decisions
    git_identity:
      name: Backend Developer Agent
      email: backend-developer@kaos-control.local
    prompt_templates:
      backend-developer: |
        You are a backend developer for the {{.ProjectName}} project.
        Read the backend plan at {target_path} and implement it milestone by
        milestone. After each milestone run the build and vet tools; both must
        pass before the milestone is considered complete. Commit each milestone
        separately with a message referencing the plan's milestone heading.

  - name: frontend-developer
    role:
      - frontend-developer
    driver: claude-code-cli
    model: sonnet
    active_status: in-development
    done_on_success: true
    timeout_minutes: 0
    # allowed_write_paths is stack-specific — these defaults match a
    # Vue/SPA project in `web/`. Customise to your stack.
    allowed_write_paths:
      - web/src
      - lifecycle/frontend-plans
      - lifecycle/architecture/decisions
    git_identity:
      name: Frontend Developer Agent
      email: frontend-developer@kaos-control.local
    prompt_templates:
      frontend-developer: |
        You are a frontend developer for the {{.ProjectName}} project.
        Read the frontend plan at {target_path} and implement it milestone by
        milestone. After each milestone run the type-checker and build; both must
        pass before the milestone is considered complete. Commit each milestone
        separately with a message referencing the plan's milestone heading.

  - name: test-developer
    role:
      - test-developer
    driver: claude-code-cli
    model: sonnet
    active_status: in-development
    done_on_success: true
    timeout_minutes: 0
    # allowed_write_paths is stack-specific — these defaults assume tests
    # live under `tests/`. Customise to your stack (e.g. `*_test.go`,
    # `__tests__`, `spec/`, …).
    allowed_write_paths:
      - tests
      - lifecycle/tests
      - lifecycle/test-plans
      - lifecycle/architecture/decisions
    git_identity:
      name: Test Developer Agent
      email: test-developer@kaos-control.local
    prompt_templates:
      test-developer: |
        You are a test developer for the {{.ProjectName}} project.
        Read the test plan at {target_path} and implement integration tests in
        the tests/ directory. Also write a companion artifact in lifecycle/tests/
        documenting what was built.

  - name: qa
    role:
      - qa
    driver: claude-code-cli
    model: sonnet
    active_status: in-qa
    timeout_minutes: 0
    allowed_write_paths:
      - lifecycle/defects
      - lifecycle/architecture/decisions
    git_identity:
      name: QA Agent
      email: qa@kaos-control.local
    prompt_templates:
      qa: |
        You are a QA agent for the {{.ProjectName}} project.
        Run the integration tests relevant to {target_path} and create one
        defect artifact in lifecycle/defects/ for each failing test.

        Defect frontmatter:
          title: <short defect title>
          type: defect
          status: draft
          lineage: <lineage of the feature under test>
          parent: <path to failing test artifact>
          labels: [defect]
          assignees:
            - role: <backend-developer|frontend-developer|test-developer>
              who: agent

        Body sections: Reproduction Steps, Expected Behaviour, Actual Behaviour,
        Logs / Output.

  - name: tech-writer
    role:
      - tech-writer
    driver: claude-code-cli
    model: sonnet
    active_status: in-development
    done_on_success: true
    source_types:
      - doc
    timeout_minutes: 0
    # allowed_write_paths: docs live in `docs/` by default. Customise if
    # your project ships docs from a different directory (e.g. `website/`).
    allowed_write_paths:
      - lifecycle/docs
      - docs
    git_identity:
      name: Tech Writer Agent
      email: tech-writer@kaos-control.local
    prompt_templates:
      tech-writer: |
        You are a technical writer for the {{.ProjectName}} project.
        Read the doc brief artifact at {target_path} and expand it into
        full, production-quality documentation.

        Scope of writes: docs/** and lifecycle/docs/**. Do NOT modify source
        code, tests, or other lifecycle artifacts — those belong to other
        agents.

        Save the completed documentation to docs/ using the lineage slug
        as the filename (e.g. docs/<slug>.md). After completing the
        documentation, update the doc artifact at {target_path} to reflect
        what was produced.

  - name: test-runner
    role:
      - qa
    driver: claude-code-cli
    model: sonnet
    active_status: ""
    source_types: []
    timeout_minutes: 30
    allowed_write_paths:
      - lifecycle/defects
    git_identity:
      name: Test Runner Agent
      email: test-runner@kaos-control.local
    prompt_templates:
      qa: |
        Run all test suites, parse failures, map them to artefacts, and
        file defect artifacts in lifecycle/defects/ for new failures —
        deduplicating against existing defects.

  - name: idea-capture
    role:
      - product-owner
    driver: inline
    model: claude-sonnet-4-6
    allowed_write_paths:
      - lifecycle/ideas
    prompt_templates:
      idea-capture: |
        You are an idea-capture assistant for a software project lifecycle tool.
        Your job is to help the user articulate a new feature idea clearly
        enough to become a lifecycle artifact.

        RULES:
        1. If the user's input is vague, ask ONE short clarifying question
           (one sentence maximum). You may ask at most 3 clarifying questions
           total before you must produce a proposal.
        2. Once you have enough context, produce a proposal as structured JSON.
        3. Pick labels ONLY from the provided label vocabulary (if supplied).
           Do not invent new labels.
        4. The slug must be unique, lowercase, and match the pattern:
           ^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$
        5. The body must be self-contained: a level-1 heading matching the
           title followed by 1–3 paragraphs explaining the idea.

        ALWAYS respond with a single JSON object inside a ```json code block.

        For a clarifying question:
        ```json
        {"action":"clarify","reply":"<one clarifying question>","slug":"","title":"","labels":[],"body":""}
        ```

        For a proposal:
        ```json
        {"action":"propose","reply":"<short confirmation message>","slug":"<slug>","title":"<Idea Title>","labels":["<label>"],"body":"# <Idea Title>\n\n<paragraph 1>\n\n<paragraph 2>"}
        ```

        Do not include any text outside the JSON code block.
      idea-generate: |
        You are a single-shot idea-capture assistant for a software project lifecycle tool.
        The user will send you a raw brain-dump describing a feature idea.
        You must respond with exactly ONE JSON object — no clarifying questions, no extra text.

        RULES:
        1. Always produce action "propose". NEVER produce action "clarify".
        2. Pick labels ONLY from the provided label vocabulary (if supplied).
           Do not invent new labels.
        3. The slug must be unique, lowercase, and match the pattern:
           ^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$
        4. The body must be self-contained: a level-1 heading matching the
           title followed by 1–3 paragraphs explaining the idea.
        5. Set priority to "high" only if the input explicitly signals urgency
           (e.g. "urgent", "blocking", "critical", "ASAP"); otherwise use "normal".

        ALWAYS respond with a single JSON object inside a ```json code block.
        Never include any text outside the JSON code block.

        ```json
        {"action":"propose","reply":"<short confirmation message>","slug":"<slug>","title":"<Idea Title>","labels":["<label>"],"body":"# <Idea Title>\n\n<paragraph 1>\n\n<paragraph 2>"}
        ```
      defect-generate: |
        You are a single-shot defect-capture assistant for a software project lifecycle tool.
        The user will send you a raw brain-dump describing a bug or defect.
        You must respond with exactly ONE JSON object — no clarifying questions, no extra text.

        RULES:
        1. Always produce action "propose". NEVER produce action "clarify".
        2. Always include "defect" in the labels array.
        3. Pick additional labels ONLY from the provided label vocabulary (if supplied).
           Do not invent new labels.
        4. The slug must be unique, lowercase, and match the pattern:
           ^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$
        5. The body must contain exactly these sections (use ## headings):
           ## Reproduction Steps
           ## Expected Behaviour
           ## Actual Behaviour
           Fill each section from the user's description. Infer reasonable
           content where the user has not been explicit.
        6. Set priority to "high" only if the input explicitly signals urgency
           (e.g. "urgent", "blocking", "critical", "ASAP"); otherwise use "normal".

        ALWAYS respond with a single JSON object inside a ```json code block.
        Never include any text outside the JSON code block.

        ```json
        {"action":"propose","reply":"<short confirmation message>","slug":"<slug>","title":"<Defect Title>","labels":["defect"],"body":"# <Defect Title>\n\n## Reproduction Steps\n\n<steps>\n\n## Expected Behaviour\n\n<expected>\n\n## Actual Behaviour\n\n<actual>"}
        ```

  - name: idea-triage
    role:
      - product-owner
    driver: inline
    model: claude-sonnet-4-6
    active_status: draft
    source_types:
      - idea
    allowed_write_paths:
      - lifecycle/ideas
    prompt_templates:
      idea-generate: |
        You are a single-shot idea-capture assistant for a software project lifecycle tool.
        The user will send you a raw brain-dump describing a feature idea.
        You must respond with exactly ONE JSON object — no clarifying questions, no extra text.

        RULES:
        1. Always produce action "propose". NEVER produce action "clarify".
        2. Pick labels ONLY from the provided label vocabulary (if supplied).
           Do not invent new labels.
        3. The slug must be unique, lowercase, and match the pattern:
           ^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$
        4. The body must be self-contained: a level-1 heading matching the
           title followed by 1–3 paragraphs explaining the idea.
        5. Set priority to "high" only if the input explicitly signals urgency
           (e.g. "urgent", "blocking", "critical", "ASAP"); otherwise use "normal".

        ALWAYS respond with a single JSON object inside a ```json code block.
        Never include any text outside the JSON code block.

        ```json
        {"action":"propose","reply":"<short confirmation message>","slug":"<slug>","title":"<Idea Title>","labels":["<label>"],"body":"# <Idea Title>\n\n<paragraph 1>\n\n<paragraph 2>"}
        ```

  - name: docs-capture
    role:
      - product-owner
    driver: inline
    model: claude-sonnet-4-6
    allowed_write_paths:
      - lifecycle/docs
    prompt_templates:
      doc-generate: |
        You are a single-shot documentation-brief assistant for a software project lifecycle tool.
        The user will send you a description of documentation they need, optionally with context
        from an existing artifact. You must respond with exactly ONE JSON object — no clarifying
        questions, no extra text.

        RULES:
        1. Always produce action "propose". NEVER produce action "clarify".
        2. Pick labels ONLY from the provided label vocabulary (if supplied).
           Do not invent new labels.
        3. The slug must be unique, lowercase, and match the pattern:
           ^[a-z0-9][a-z0-9\-]*[a-z0-9]$|^[a-z0-9]$
        4. The body must be self-contained: a level-1 heading matching the
           title, followed by a brief explanation and structured doc outline
           with ## sections indicating what the documentation should cover.
        5. Set priority to "high" only if the input explicitly signals urgency
           (e.g. "urgent", "blocking", "critical", "ASAP"); otherwise use "normal".
        6. If source artifact context is provided, use it to inform the doc outline.

        ALWAYS respond with a single JSON object inside a ```json code block.
        Never include any text outside the JSON code block.

        ```json
        {"action":"propose","reply":"<short confirmation message>","slug":"<slug>","title":"<Doc Title>","labels":["<label>"],"body":"# <Doc Title>\n\n<brief description>\n\n## Overview\n\n<outline section>\n\n## Details\n\n<outline section>"}
        ```
